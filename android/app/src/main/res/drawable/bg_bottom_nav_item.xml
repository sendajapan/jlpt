<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="8dp" android:insetBottom="8dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/color_theme_extra_light" />
                <stroke android:width="0dp" android:color="@color/color_theme_light" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
