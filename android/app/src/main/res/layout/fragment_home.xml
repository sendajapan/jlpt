<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_100sdp">

        <!-- STATS ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_round_white"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/_8sdp">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_day_streak"
                    app:tint="@color/color_theme_navy" />

                <TextView
                    android:id="@+id/txtStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/_16ssp"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAY STREAK"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/color_theme_black"
                    android:textSize="@dimen/_9ssp"
                    android:includeFontPadding="false"/>
            </LinearLayout>

            <View
                android:layout_width="@dimen/_8sdp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_round_white"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/_8sdp">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_badge"
                    app:tint="@color/color_theme_navy" />

                <TextView
                    android:id="@+id/txtWordsKnown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/_16sdp"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WORDS"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/color_theme_black"
                    android:textSize="@dimen/_9ssp"
                    android:includeFontPadding="false"/>
            </LinearLayout>

            <View
                android:layout_width="@dimen/_8sdp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_round_white"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/_8sdp">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/color_theme_navy" />

                <TextView
                    android:id="@+id/txtXpDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12m"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/_16ssp"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XP"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/color_theme_black"
                    android:textSize="@dimen/_9ssp"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>

        <!-- LEARN JAPANESE DAILY CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_16sdp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Learn Japanese Daily"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:text="DAY STREAK"
                            android:textColor="@color/color_theme_dark"
                            android:textSize="@dimen/_11ssp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtLessonPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0% complete"
                                android:fontFamily="@font/poppins_bold"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/_20ssp"
                                android:includeFontPadding="false"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/txtLessonFraction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:background="@drawable/bg_pill_blue"
                                android:backgroundTint="@color/color_theme_light"
                                android:paddingHorizontal="@dimen/_10sdp"
                                android:paddingVertical="@dimen/_4sdp"
                                android:text="0 / 5"
                                android:fontFamily="@font/poppins_bold"
                                android:textSize="@dimen/_10ssp"
                                android:includeFontPadding="false"/>
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="@dimen/_60sdp"
                        android:layout_height="@dimen/_60sdp"
                        android:background="@drawable/bg_circle_sage">

                        <ImageView
                            android:layout_width="@dimen/_40sdp"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_gravity="center"
                            app:tint="@color/white" />
                    </FrameLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressLesson"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_8sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="@color/color_theme_light"
                    android:progressTint="@color/color_theme_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="keep it up! almost there 👏"
                    android:textColor="@color/ink_soft"
                    android:textSize="@dimen/_12ssp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartLesson"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Start Lesson"
                    android:textColor="@color/color_theme_navy"
                    android:textSize="@dimen/_14ssp"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    app:backgroundTint="@color/color_theme_light"
                    app:cornerRadius="@dimen/_8sdp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CATEGORIES SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Categories"
                android:textColor="@color/ink"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See All"
                android:textColor="@color/sage_deep"
                android:textSize="@dimen/_14ssp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/loadingCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_16sdp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
