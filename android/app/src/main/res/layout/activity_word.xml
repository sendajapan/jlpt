<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/layout_auth_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.scholarlyapps.pathlingo.ui.views.HeaderToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_theme_light"
        app:showBackButton="true"
        app:showAvatar="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/color_theme_light"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/color_theme_navy"
        app:tabTextColor="@color/ink_soft"
        app:tabSelectedTextColor="@color/color_theme_navy"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sentence" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Story" />

    </com.google.android.material.tabs.TabLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_16sdp">

            <!-- Word Tab Content -->
            <LinearLayout
                android:id="@+id/contentWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_200sdp"
                    android:layout_marginBottom="@dimen/_16sdp"
                    app:cardCornerRadius="@dimen/_16sdp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/imgWord"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="center" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_16sdp"
                    app:cardCornerRadius="@dimen/_12sdp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_16sdp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="JAPANESE"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:textColor="@color/ink_soft"
                                    android:textSize="@dimen/_9ssp"
                                    android:layout_marginBottom="@dimen/_2sdp" />

                                <TextView
                                    android:id="@+id/txtKanji"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/noto_sans_jp_bold"
                                    android:textColor="@color/ink"
                                    android:textSize="@dimen/_28ssp" />

                                <TextView
                                    android:id="@+id/txtReading"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/noto_sans_jp"
                                    android:textColor="@color/ink_soft"
                                    android:textSize="@dimen/_12ssp" />

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/btnPlayWord"
                                android:layout_width="@dimen/_40sdp"
                                android:layout_height="@dimen/_40sdp"
                                android:src="@drawable/ic_speaker"
                                android:padding="@dimen/_10sdp"
                                android:background="@drawable/bg_round_white"
                                android:backgroundTint="@color/color_theme_extra_light"
                                app:tint="@color/color_theme_navy" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="@dimen/_12sdp"
                            android:background="@color/color_theme_extra_light" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ROMAJI"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:textColor="@color/ink_soft"
                                    android:textSize="@dimen/_9ssp"
                                    android:layout_marginBottom="@dimen/_2sdp" />

                                <TextView
                                    android:id="@+id/txtRomaji"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:textColor="@color/ink"
                                    android:textSize="@dimen/_14ssp" />

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/btnPlayRomaji"
                                android:layout_width="@dimen/_40sdp"
                                android:layout_height="@dimen/_40sdp"
                                android:src="@drawable/ic_speaker"
                                android:padding="@dimen/_10sdp"
                                android:background="@drawable/bg_round_white"
                                android:backgroundTint="@color/color_theme_extra_light"
                                app:tint="@color/color_theme_navy" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="@dimen/_12sdp"
                            android:background="@color/color_theme_extra_light" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ENGLISH"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:textColor="@color/ink_soft"
                                    android:textSize="@dimen/_9ssp"
                                    android:layout_marginBottom="@dimen/_2sdp" />

                                <TextView
                                    android:id="@+id/txtEn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="@color/color_theme_navy"
                                    android:textSize="@dimen/_16ssp" />

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/btnPlayEn"
                                android:layout_width="@dimen/_40sdp"
                                android:layout_height="@dimen/_40sdp"
                                android:src="@drawable/ic_speaker"
                                android:padding="@dimen/_10sdp"
                                android:background="@drawable/bg_round_white"
                                android:backgroundTint="@color/color_theme_extra_light"
                                app:tint="@color/color_theme_navy" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/_12sdp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFavorite"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_44sdp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:text="Favorite"
                        android:textSize="@dimen/_11ssp"
                        android:fontFamily="@font/poppins_semibold"
                        app:icon="@drawable/ic_heart"
                        app:iconSize="@dimen/_16sdp"
                        app:iconGravity="textStart"
                        app:iconTint="@color/color_theme_navy"
                        app:strokeColor="@color/color_theme_navy"
                        app:strokeWidth="1.5dp"
                        android:textColor="@color/color_theme_navy"
                        app:cornerRadius="@dimen/_8sdp"
                        app:rippleColor="@color/color_theme_extra_light" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBookmark"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_44sdp"
                        android:layout_weight="1"
                        android:text="Bookmark"
                        android:textSize="@dimen/_11ssp"
                        android:fontFamily="@font/poppins_semibold"
                        app:icon="@drawable/ic_bookmark"
                        app:iconSize="@dimen/_16sdp"
                        app:iconGravity="textStart"
                        app:iconTint="@color/color_theme_navy"
                        app:strokeColor="@color/color_theme_navy"
                        app:strokeWidth="1.5dp"
                        android:textColor="@color/color_theme_navy"
                        app:cornerRadius="@dimen/_8sdp"
                        app:rippleColor="@color/color_theme_extra_light" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLearn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_52sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:text="I have learned this  (+100 coins)"
                    android:textSize="@dimen/_10ssp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/color_theme_navy"
                    app:cornerRadius="@dimen/_12sdp"
                    app:rippleColor="@color/color_theme_dark" />

            </LinearLayout>

            <!-- Sentence Tab Content -->
            <LinearLayout
                android:id="@+id/contentSentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_12sdp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_16sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EXAMPLE SENTENCE"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/ink_soft"
                            android:textSize="@dimen/_9ssp"
                            android:layout_marginBottom="@dimen/_12sdp" />

                        <TextView
                            android:id="@+id/txtExampleJp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/noto_sans_jp_bold"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/_16ssp"
                            android:layout_marginBottom="@dimen/_8sdp" />

                        <TextView
                            android:id="@+id/txtExampleRomaji"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/ink_soft"
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="italic"
                            android:layout_marginBottom="@dimen/_8sdp" />

                        <TextView
                            android:id="@+id/txtExampleEn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/color_theme_navy"
                            android:textSize="@dimen/_13ssp"
                            android:layout_marginBottom="@dimen/_12sdp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="end">

                            <ImageView
                                android:id="@+id/btnPlaySentence"
                                android:layout_width="@dimen/_40sdp"
                                android:layout_height="@dimen/_40sdp"
                                android:src="@drawable/ic_speaker"
                                android:padding="@dimen/_10sdp"
                                android:background="@drawable/bg_round_white"
                                android:backgroundTint="@color/color_theme_extra_light"
                                app:tint="@color/color_theme_navy" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Story Tab Content -->
            <LinearLayout
                android:id="@+id/contentStory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_12sdp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_200sdp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/_24sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📖"
                            android:textSize="@dimen/_40ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_12sdp"
                            android:text="Coming Soon"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/_16ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:text="Story feature will be available soon."
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/ink_soft"
                            android:textSize="@dimen/_12ssp"
                            android:gravity="center" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
