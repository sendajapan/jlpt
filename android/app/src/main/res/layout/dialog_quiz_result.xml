<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_round_white">

    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:lottie_rawRes="@raw/confetti"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:layout_marginVertical="-100dp"
        app:layout_constraintTop_toTopOf="@id/contentLayout"
        app:layout_constraintBottom_toBottomOf="@id/contentLayout"
        app:layout_constraintStart_toStartOf="@id/contentLayout"
        app:layout_constraintEnd_toEndOf="@id/contentLayout" />

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/_24sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="@dimen/_160sdp"
            android:layout_height="@dimen/_100sdp"
            app:lottie_rawRes="@raw/trophy"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"
            android:layout_marginBottom="@dimen/_8sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Great Job!"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/color_theme_navy"
            android:textSize="@dimen/_22ssp"
            android:includeFontPadding="false"
            android:layout_marginBottom="@dimen/_4sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You have completed this quiz"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@android:color/darker_gray"
            android:textSize="@dimen/_12ssp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:includeFontPadding="false"/>

        <TextView
            android:id="@+id/txtResultScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/color_theme_navy"
            android:textSize="@dimen/_32ssp"
            android:layout_marginBottom="@dimen/_4sdp" />

        <TextView
            android:id="@+id/txtResultCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/_12ssp"
            android:layout_marginBottom="@dimen/_4sdp" />

        <TextView
            android:id="@+id/txtResultXp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/color_theme_navy"
            android:textSize="@dimen/_12ssp"
            android:layout_marginBottom="@dimen/_16sdp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewResult"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:text="View Result"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/color_theme_navy"
            android:textSize="@dimen/_12ssp"
            android:textAllCaps="false"
            app:backgroundTint="@color/color_theme_light"
            app:cornerRadius="@dimen/_8sdp"
            app:rippleColor="@color/color_theme_extra_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTryAgain"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:text="Try Again"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/color_theme_navy"
            android:textSize="@dimen/_12ssp"
            android:textAllCaps="false"
            app:strokeColor="@color/color_theme_navy"
            app:strokeWidth="1.5dp"
            app:cornerRadius="@dimen/_8sdp"
            app:rippleColor="@color/color_theme_extra_light" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
