<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="@dimen/_24sdp"
    android:background="@drawable/bg_round_white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏆"
        android:textSize="@dimen/_40ssp"
        android:layout_marginBottom="@dimen/_8sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quiz Complete!"
        android:fontFamily="@font/poppins_bold"
        android:textColor="@color/ink"
        android:textSize="@dimen/_18ssp"
        android:layout_marginBottom="@dimen/_4sdp" />

    <TextView
        android:id="@+id/txtResultScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:textColor="@color/color_theme_navy"
        android:textSize="@dimen/_40ssp"
        android:layout_marginBottom="@dimen/_4sdp" />

    <TextView
        android:id="@+id/txtResultCoins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/ink_soft"
        android:textSize="@dimen/_12ssp"
        android:layout_marginBottom="@dimen/_4sdp" />

    <TextView
        android:id="@+id/txtResultXp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/color_theme_navy"
        android:textSize="@dimen/_12ssp"
        android:layout_marginBottom="@dimen/_24sdp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewResult"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_46sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:text="View Result"
        android:fontFamily="@font/poppins_bold"
        android:textColor="@color/color_theme_navy"
        android:textSize="@dimen/_14ssp"
        android:textAllCaps="false"
        app:backgroundTint="@color/color_theme_light"
        app:cornerRadius="@dimen/_8sdp"
        app:rippleColor="@color/color_theme_extra_light" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTryAgain"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_46sdp"
        android:text="Try Again"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/color_theme_navy"
        android:textSize="@dimen/_14ssp"
        android:textAllCaps="false"
        app:strokeColor="@color/color_theme_navy"
        app:strokeWidth="1.5dp"
        app:cornerRadius="@dimen/_8sdp"
        app:rippleColor="@color/color_theme_extra_light" />

</LinearLayout>
