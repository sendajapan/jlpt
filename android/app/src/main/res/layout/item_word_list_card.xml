<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_12sdp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/_8sdp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_12sdp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/imgContainer"
            android:layout_width="@dimen/_72sdp"
            android:layout_height="@dimen/_72sdp"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/imgBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/icChevron"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/ink_mute"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtEn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:textColor="@color/ink"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintStart_toEndOf="@id/imgContainer"
            app:layout_constraintEnd_toStartOf="@id/icChevron"
            app:layout_constraintTop_toTopOf="@id/imgContainer"
            app:layout_constraintBottom_toTopOf="@id/txtJp"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/txtJp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/noto_sans_jp_bold"
            android:includeFontPadding="false"
            android:textColor="@color/ink"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintStart_toEndOf="@id/imgContainer"
            app:layout_constraintEnd_toStartOf="@id/icChevron"
            app:layout_constraintTop_toBottomOf="@id/txtEn"
            app:layout_constraintBottom_toTopOf="@id/txtRomaji" />

        <TextView
            android:id="@+id/txtRomaji"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_1sdp"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintStart_toEndOf="@id/imgContainer"
            app:layout_constraintEnd_toStartOf="@id/icChevron"
            app:layout_constraintTop_toBottomOf="@id/txtJp"
            app:layout_constraintBottom_toBottomOf="@id/imgContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
