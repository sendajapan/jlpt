<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAvatar"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_round_white"
            app:shapeAppearanceOverlay="@style/ShapeOverlay.Avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_10sdp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello,"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/ink"
                android:textSize="@dimen/_11ssp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/ink"
                android:text="Solaiman"
                android:textSize="@dimen/_12ssp"
                android:includeFontPadding="false" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_36sdp"
            android:gravity="center|end">

            <LinearLayout
                android:id="@+id/layoutCoin"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_32sdp"
                android:paddingHorizontal="@dimen/_8sdp"
                android:background="@drawable/bg_round_white"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.airbnb.lottie.LottieAnimationView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    app:lottie_rawRes="@raw/dollar_coin"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true" />

                <TextView
                    android:id="@+id/txtCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnBell"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:background="@drawable/bg_round_white">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/ink" />

                <View
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="@dimen/_8sdp"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/_4sdp"
                    android:background="@drawable/bg_badge_red" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</merge>
