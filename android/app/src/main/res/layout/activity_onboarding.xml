<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/layout_auth_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: step label + skip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/_48sdp"
            android:paddingStart="@dimen/_24sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:paddingBottom="@dimen/_12sdp">

            <TextView
                android:id="@+id/txtStepIndicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:text="Step 1 of 3"
                android:textColor="@color/color_theme_dark"
                android:textSize="@dimen/_12ssp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkip"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_24sdp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/_14sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:fontFamily="@font/poppins_bold"
                android:text="Skip"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:textColor="@color/color_theme_dark"
                android:textSize="@dimen/_11ssp"
                app:cornerRadius="@dimen/_8sdp"
                app:strokeColor="@color/color_theme_light"
                app:strokeWidth="2dp" />

        </LinearLayout>

        <!-- Step progress bars -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_4sdp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_24sdp"
            android:paddingEnd="@dimen/_24sdp">

            <View
                android:id="@+id/stepBar1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_step_bar_active" />

            <Space android:layout_width="@dimen/_6sdp" android:layout_height="match_parent" />

            <View
                android:id="@+id/stepBar2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_step_bar_inactive" />

            <Space android:layout_width="@dimen/_6sdp" android:layout_height="match_parent" />

            <View
                android:id="@+id/stepBar3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_step_bar_inactive" />

        </LinearLayout>

        <!-- Pager content -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/_8sdp" />

        <!-- Bottom buttons: Back (gone on step 1) + Continue -->
        <LinearLayout
            android:id="@+id/btnContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="@dimen/_24sdp"
            android:layout_marginHorizontal="@dimen/_20sdp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_46sdp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_10sdp"
                android:fontFamily="@font/poppins_bold"
                android:text="Back"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:textColor="@color/color_theme_dark"
                android:textSize="@dimen/_11ssp"
                android:visibility="gone"
                app:cornerRadius="@dimen/_8sdp"
                app:strokeColor="@color/color_theme_dark"
                app:strokeWidth="1dp"
                android:layout_marginHorizontal="@dimen/_4sdp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="0dp"
                android:layout_height="@dimen/_46sdp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:text="Continue"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:textColor="@color/color_theme_navy"
                android:textSize="@dimen/_11ssp"
                app:backgroundTint="@color/color_theme_light"
                app:cornerRadius="@dimen/_8sdp"
                android:layout_marginHorizontal="@dimen/_4sdp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
