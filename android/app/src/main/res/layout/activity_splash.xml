<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/layout_auth_background" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/txtAppNameJapanese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name_jp"
            android:textAlignment="center"
            android:fontFamily="@font/lato_bold"
            android:textSize="32sp"/>

        <TextView
            android:id="@+id/txtAppNameEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato_black"
            android:includeFontPadding="false"
            android:text="@string/app_name"
            android:textAlignment="center"
            android:textAllCaps="true"
            android:textColor="@color/color_theme_dark"
            android:textSize="36sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:src="@drawable/logo_splash"
            android:layout_marginVertical="20dp"/>

        <TextView
            android:id="@+id/txtAppSlogan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_slogan"
            android:textAlignment="center"
            android:fontFamily="@font/lato"
            android:textSize="16sp"
            android:letterSpacing=".12"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
