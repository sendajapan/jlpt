<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/layout_auth_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/txtAppNameJapanese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name_jp"
            android:textAlignment="center"
            android:fontFamily="@font/lato_bold"
            android:textSize="@dimen/_28ssp" />

        <TextView
            android:id="@+id/txtAppNameEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato_black"
            android:includeFontPadding="false"
            android:text="@string/app_name"
            android:textAlignment="center"
            android:textAllCaps="true"
            android:textColor="@color/color_theme_dark"
            android:textSize="@dimen/_28ssp" />

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_200sdp"
            android:src="@drawable/logo_splash"
            android:layout_marginVertical="@dimen/_20sdp" />

        <TextView
            android:id="@+id/txtAppSlogan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_slogan"
            android:textAlignment="center"
            android:fontFamily="@font/lato_bold"
            android:textSize="@dimen/_12ssp"
            android:letterSpacing=".12" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
