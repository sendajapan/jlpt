<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/layout_auth_background" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_24sdp"
            android:paddingVertical="@dimen/_32sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_bold"
                android:text="Verify Email"
                android:textAllCaps="true"
                android:textColor="@color/color_theme_dark"
                android:textSize="@dimen/_32ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_bold"
                android:text="Enter the 4-digit code sent to"
                android:textColor="@color/color_theme_black"
                android:textSize="@dimen/_12ssp"
                android:layout_marginTop="@dimen/_8sdp" />

            <TextView
                android:id="@+id/textEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_bold"
                android:textColor="@color/color_theme_dark"
                android:textSize="@dimen/_12ssp"
                android:layout_marginTop="@dimen/_2sdp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/_32sdp">

                <EditText
                    android:id="@+id/digit1"
                    android:layout_width="@dimen/_52sdp"
                    android:layout_height="@dimen/_56sdp"
                    android:background="@drawable/bg_otp_digit"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textSize="@dimen/_22ssp"
                    android:textColor="@color/color_theme_dark"
                    android:fontFamily="@font/lato_bold"
                    android:cursorVisible="false" />

                <View
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="1dp" />

                <EditText
                    android:id="@+id/digit2"
                    android:layout_width="@dimen/_52sdp"
                    android:layout_height="@dimen/_56sdp"
                    android:background="@drawable/bg_otp_digit"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textSize="@dimen/_22ssp"
                    android:textColor="@color/color_theme_dark"
                    android:fontFamily="@font/lato_bold"
                    android:cursorVisible="false" />

                <View
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="1dp" />

                <EditText
                    android:id="@+id/digit3"
                    android:layout_width="@dimen/_52sdp"
                    android:layout_height="@dimen/_56sdp"
                    android:background="@drawable/bg_otp_digit"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textSize="@dimen/_22ssp"
                    android:textColor="@color/color_theme_dark"
                    android:fontFamily="@font/lato_bold"
                    android:cursorVisible="false" />

                <View
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="1dp" />

                <EditText
                    android:id="@+id/digit4"
                    android:layout_width="@dimen/_52sdp"
                    android:layout_height="@dimen/_56sdp"
                    android:background="@drawable/bg_otp_digit"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textSize="@dimen/_22ssp"
                    android:textColor="@color/color_theme_dark"
                    android:fontFamily="@font/lato_bold"
                    android:cursorVisible="false" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_46sdp"
                android:layout_marginTop="@dimen/_28sdp"
                android:text="Verify"
                android:fontFamily="@font/lato_bold"
                android:textColor="@color/color_theme_navy"
                android:textSize="@dimen/_14ssp"
                android:textAllCaps="false"
                android:letterSpacing="0"
                app:backgroundTint="@color/color_theme_light"
                app:cornerRadius="@dimen/_8sdp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResend"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_46sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:fontFamily="@font/lato_bold"
                android:text="Resend OTP (60s)"
                android:textAllCaps="false"
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/color_theme_dark"
                android:letterSpacing="0"
                android:enabled="false"
                app:cornerRadius="@dimen/_8sdp"
                app:strokeColor="@color/color_theme_dark"
                app:strokeWidth="1dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_12sdp"
                android:indeterminateTint="@color/color_theme_dark"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_16sdp"
                android:fontFamily="@font/lato_bold"
                android:text="Skip for now"
                android:textColor="@color/color_theme_black"
                android:textSize="@dimen/_12ssp"
                android:alpha="0.6" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
