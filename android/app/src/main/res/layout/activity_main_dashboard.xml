<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/layout_auth_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="@dimen/_8sdp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false"
            app:toolbarId="@id/header">

            <LinearLayout
                android:id="@+id/expandedHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingTop="@dimen/_16sdp"
                android:paddingBottom="@dimen/_16sdp"
                app:layout_collapseMode="parallax">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgExpandedAvatar"
                    android:layout_width="@dimen/_46sdp"
                    android:layout_height="@dimen/_46sdp"
                    android:background="@drawable/bg_step_bar_inactive"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeOverlay.Avatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtExpandedDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="Tuesday, June 9"
                        android:textColor="@color/color_theme_navy"
                        android:textSize="@dimen/_9ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/noto_sans_jp_bold"
                        android:includeFontPadding="false"
                        android:text="こんにちは！"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/_10ssp" />

                    <TextView
                        android:id="@+id/txtExpandedName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sulaiman"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/_12ssp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/btnExpandedBell"
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:background="@drawable/bg_round_white">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bell"
                            app:tint="@color/ink" />

                        <View
                            android:layout_width="@dimen/_6sdp"
                            android:layout_height="@dimen/_6sdp"
                            android:layout_gravity="top|end"
                            android:layout_margin="@dimen/_3sdp"
                            android:background="@drawable/bg_badge_red" />

                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/layoutExpandedCoin"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_28sdp"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:background="@drawable/bg_round_white"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.airbnb.lottie.LottieAnimationView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/dollar_coin" />

                        <TextView
                            android:id="@+id/txtExpandedCoins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50,000"
                            android:layout_marginStart="@dimen/_3sdp"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/_10ssp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <com.scholarlyapps.pathlingo.ui.views.HeaderToolbar
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:alpha="0"
                android:background="@color/color_theme_light"
                android:paddingHorizontal="@dimen/_16sdp"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHost"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:navGraph="@navigation/nav_graph"
        tools:layout="@layout/fragment_home" />

    <LinearLayout
        android:id="@+id/bottomNavWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="12dp"
        android:orientation="vertical">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_72sdp"
            android:background="@color/white"
            android:elevation="0dp"
            app:itemActiveIndicatorStyle="@style/BottomNavActiveIndicatorStyle"
            app:itemBackground="@drawable/bg_bottom_nav_item"
            app:itemIconSize="@dimen/_24sdp"
            app:itemIconTint="@null"
            app:itemPaddingTop="@dimen/_12sdp"
            app:itemPaddingBottom="@dimen/_12sdp"
            app:itemTextAppearanceActive="@style/BottomNavLabelActive"
            app:itemTextAppearanceInactive="@style/BottomNavLabelInactive"
            app:itemTextColor="@color/bottom_nav_label"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
