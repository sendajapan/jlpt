<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical">

    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/bg_chip_sage" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_14sdp"
        android:paddingBottom="@dimen/_8sdp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="Choose Avatar"
            android:textColor="@color/ink"
            android:textSize="@dimen/_14ssp"
            android:includeFontPadding="false"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pill_blue"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_2sdp">

            <TextView
                android:id="@+id/txtCoinBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="0 coins"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:includeFontPadding="false"/>

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="@dimen/_24sdp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAvatars"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_320sdp"
        android:nestedScrollingEnabled="true"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingTop="@dimen/_4sdp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_avatar_grid"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"/>

    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_160sdp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="No avatars available"
        android:textColor="@color/ink_soft"
        android:textSize="@dimen/_12ssp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingBottom="@dimen/_24sdp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="@dimen/_12ssp"
            app:cornerRadius="@dimen/_8sdp"
            app:strokeColor="@color/ink_soft" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChoose"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_weight="1"
            android:enabled="false"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0"
            android:text="Choose"
            android:textAllCaps="false"
            android:textColor="@color/color_theme_navy"
            android:textSize="@dimen/_12ssp"
            app:backgroundTint="@color/color_theme_light"
            app:cornerRadius="@dimen/_8sdp" />

    </LinearLayout>

</LinearLayout>
