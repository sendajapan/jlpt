<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_24sdp"
        android:paddingTop="@dimen/_20sdp"
        android:paddingBottom="@dimen/_16sdp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato_black"
            android:text="Almost there !"
            android:textColor="@color/color_theme_dark"
            android:textSize="@dimen/_22ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:fontFamily="@font/lato"
            android:text="Just a few last details to personalize\nthe best for your learning path."
            android:textColor="@color/color_theme_black"
            android:textSize="@dimen/_11ssp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_24sdp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_bold"
                    android:text="From Language"
                    android:textColor="@color/color_theme_black"
                    android:textSize="@dimen/_10ssp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:background="@drawable/bg_onboarding_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_4sdp">

                    <Spinner
                        android:id="@+id/spinnerFromLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="46sp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:fontFamily="@font/lato_bold"
                android:text="→"
                android:textColor="@color/color_theme_dark"
                android:textSize="@dimen/_16ssp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_bold"
                    android:text="To Language"
                    android:textColor="@color/color_theme_black"
                    android:textSize="@dimen/_10ssp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:background="@drawable/bg_onboarding_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_4sdp">

                    <Spinner
                        android:id="@+id/spinnerToLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24sdp"
            android:fontFamily="@font/lato_bold"
            android:text="Daily Goal (minutes)"
            android:textColor="@color/color_theme_black"
            android:textSize="@dimen/_12ssp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_8sdp">

            <LinearLayout
                android:id="@+id/chip15min"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_onboarding_unselected"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_bold"
                    android:text="15 min"
                    android:textColor="@color/color_theme_black"
                    android:textSize="@dimen/_10ssp" />

            </LinearLayout>

            <Space android:layout_width="@dimen/_6sdp" android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/chip30min"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_onboarding_unselected"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_bold"
                    android:text="30 min"
                    android:textColor="@color/color_theme_black"
                    android:textSize="@dimen/_10ssp" />

            </LinearLayout>

            <Space android:layout_width="@dimen/_6sdp" android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/chip1hour"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_onboarding_unselected"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_bold"
                    android:text="1 hour"
                    android:textColor="@color/color_theme_black"
                    android:textSize="@dimen/_10ssp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_6sdp">

            <LinearLayout
                android:id="@+id/chip2hours"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_onboarding_unselected"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_bold"
                    android:text="2 hours"
                    android:textColor="@color/color_theme_black"
                    android:textSize="@dimen/_10ssp" />

            </LinearLayout>

            <Space android:layout_width="@dimen/_6sdp" android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/chip3hours"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_onboarding_unselected"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_bold"
                    android:text="3 hours"
                    android:textColor="@color/color_theme_black"
                    android:textSize="@dimen/_10ssp" />

            </LinearLayout>

            <Space android:layout_width="@dimen/_6sdp" android:layout_height="match_parent" />

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:layout_weight="1" />

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardTrophy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/_12sdp"
            app:cardBackgroundColor="@color/color_theme_light"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/_16sdp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆"
                    android:textSize="@dimen/_28ssp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:fontFamily="@font/lato_bold"
                    android:text="Great choice! You're all set to start your language learning journey."
                    android:textColor="@color/color_theme_navy"
                    android:textSize="@dimen/_11ssp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
