<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BottomNavShapeOverlay" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="BottomNavActiveIndicatorStyle">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
    </style>

    <style name="BottomNavLabelActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/lato_bold</item>
    </style>

    <style name="BottomNavLabelInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/color_theme_dark</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/lato_bold</item>
    </style>

    <style name="Theme.PathLingo" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_theme_dark</item>
        <item name="colorSecondary">@color/color_theme_dark_black</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:textColor">@color/color_theme_black</item>
        <item name="android:textColorPrimary">@color/color_theme_black</item>
        <item name="android:textColorSecondary">@color/color_theme_dark</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>
</resources>
