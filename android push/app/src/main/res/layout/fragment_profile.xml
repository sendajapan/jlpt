<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_profile"
        android:scaleType="centerCrop" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="←"
                android:layout_marginBottom="16dp" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_owl"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hana Watanabe"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/user_jp_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="はなちゃん"
                android:textSize="12sp"
                android:textColor="@color/ink_soft"
                android:layout_marginBottom="16dp" />

            <!-- Level card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LEVEL"
                        android:textSize="10sp"
                        android:textColor="@color/ink_soft"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/user_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Level 7"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink"
                        android:layout_marginBottom="8dp" />

                    <ProgressBar
                        android:id="@+id/xp_progress"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:progress="64"
                        android:background="@drawable/progress_bg"
                        android:progressDrawable="@drawable/progress_bar"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/user_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="320/500 XP"
                        android:textSize="10sp"
                        android:textColor="@color/ink_soft" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/stat_words"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="142 words"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Words Known"
                        android:textSize="10sp"
                        android:textColor="@color/ink_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="16dp">

                    <TextView
                        android:id="@+id/stat_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 day"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/terra"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Streak"
                        android:textSize="10sp"
                        android:textColor="@color/ink_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/stat_accuracy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="86%"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/sage"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accuracy"
                        android:textSize="10sp"
                        android:textColor="@color/ink_soft" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
