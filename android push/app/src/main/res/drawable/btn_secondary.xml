<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/shape">
        <shape android:shape="rectangle">
            <solid android:color="@color/hajime_terra" />
            <corners android:radius="999dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#D78867"
                android:endColor="#B86C4D" />
        </shape>
    </item>
    <item android:id="@+id/ripple">
        <ripple android:color="@color/hajime_terra_deep" android:radius="999dp" />
    </item>
</layer-list>
