{
    "openapi": "3.0.0",
    "info": {
        "title": "JLPT Mobile API",
        "description": "REST API for the JLPT mobile app. All authenticated endpoints expect a Sanctum bearer token issued by /auth/login or /auth/register.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://pathlingo.scholarlyapps.com",
            "description": "API Server"
        }
    ],
    "paths": {
        "/api/v1/auth/email/verify-send": {
            "post": {
                "tags": ["Auth"],
                "summary": "Resend the email verification link to the authenticated user",
                "operationId": "5d032c70d8c86f3619b9d0b7f9d6dcf4",
                "responses": {
                    "200": { "description": "Verification email sent" }
                },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/auth/email/verify/{id}/{hash}": {
            "get": {
                "tags": ["Auth"],
                "summary": "Confirm email via the signed link sent over email",
                "operationId": "d3488e1ddfc474c63037c03f7700c4e3",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
                    { "name": "hash", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": { "description": "Email verified" },
                    "403": { "description": "Invalid verification link" }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "tags": ["Auth"],
                "summary": "Login with email and password",
                "operationId": "02f6ee354f76eb020df20e4d9b68bbb0",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["email", "password", "device_name"],
                                "properties": {
                                    "email": { "type": "string", "format": "email", "example": "sulaiman@sendajapan.com" },
                                    "password": { "type": "string", "format": "password", "example": "p@ssword" },
                                    "device_name": { "type": "string", "example": "iphone-15" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
                    },
                    "422": {
                        "description": "Invalid credentials",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } }
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "tags": ["Auth"],
                "summary": "Revoke the current Sanctum token",
                "operationId": "1fcdff85716dc0d10e8a019b9817a86d",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": { "properties": { "message": { "type": "string" } }, "type": "object" }
                            }
                        }
                    },
                    "401": { "description": "Unauthenticated" }
                },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/auth/guest": {
            "post": {
                "tags": ["Auth"],
                "summary": "Create or resume a guest session",
                "description": "Returns a Sanctum token for a guest account. Pass device_name to resume the same guest account on subsequent calls from the same device.",
                "operationId": "auth_guest",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["device_name"],
                                "properties": {
                                    "device_name": { "type": "string", "example": "pixel-8" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
                    }
                }
            }
        },
        "/api/v1/auth/otp/send": {
            "post": {
                "tags": ["Auth"],
                "summary": "Send OTP verification code to the given email (no auth required)",
                "operationId": "b11663e801f876d78c53563e1c3a6c2f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["user_email"],
                                "properties": {
                                    "user_email": { "type": "string", "format": "email", "example": "user@example.com" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP sent",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": { "message": { "type": "string", "example": "OTP sent to your email." } },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": { "description": "No account found with that email" },
                    "422": {
                        "description": "Validation error",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } }
                    }
                }
            }
        },
        "/api/v1/auth/otp/verify": {
            "post": {
                "tags": ["Auth"],
                "summary": "Verify the 4-digit OTP code to confirm email ownership (no auth required)",
                "operationId": "2109c1568ae0184daa57791e1e0bf5a7",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["user_email", "code"],
                                "properties": {
                                    "user_email": { "type": "string", "format": "email", "example": "user@example.com" },
                                    "code": { "description": "4-digit numeric OTP", "type": "string", "example": "4827", "maxLength": 4, "minLength": 4 }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Email verified",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": { "message": { "type": "string", "example": "Email verified successfully." } },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": { "description": "No account found with that email" },
                    "422": {
                        "description": "Invalid or expired OTP",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } }
                    }
                }
            }
        },
        "/api/v1/auth/forgot-password": {
            "post": {
                "tags": ["Auth"],
                "summary": "Email a password reset link",
                "operationId": "0a7dba788c42aa3703b2233c4340cbd2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["email"],
                                "properties": { "email": { "type": "string", "format": "email" } },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Reset link sent" },
                    "422": { "description": "Validation error" }
                }
            }
        },
        "/api/v1/auth/reset-password": {
            "post": {
                "tags": ["Auth"],
                "summary": "Reset password using the emailed token",
                "operationId": "8287fc6f8bbb43dd0b1932319b713607",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["token", "email", "password", "password_confirmation"],
                                "properties": {
                                    "token": { "type": "string" },
                                    "email": { "type": "string", "format": "email" },
                                    "password": { "type": "string", "format": "password", "minLength": 8 },
                                    "password_confirmation": { "type": "string", "format": "password" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Password reset" },
                    "422": { "description": "Invalid token or password" }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "tags": ["Auth"],
                "summary": "Register a new app user with email and password",
                "operationId": "b3e30f5d550777b9cf8cddeceaf2c986",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["name", "email", "password", "password_confirmation", "device_name"],
                                "properties": {
                                    "name": { "type": "string", "example": "Sulaiman MD" },
                                    "display_name": { "type": "string", "example": "smensulaiman", "nullable": true },
                                    "email": { "type": "string", "format": "email" },
                                    "password": { "type": "string", "format": "password", "minLength": 8 },
                                    "password_confirmation": { "type": "string", "format": "password" },
                                    "device_name": { "type": "string", "example": "iphone-15" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } }
                    }
                }
            }
        },
        "/api/v1/auth/social/google": {
            "post": {
                "tags": ["Auth"],
                "summary": "Login or register via Google ID token",
                "description": "Mobile app performs native Google sign-in and posts the resulting id_token here.",
                "operationId": "9b6a6db911a3ed210100276defc16b4c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["id_token", "device_name"],
                                "properties": {
                                    "id_token": { "type": "string" },
                                    "device_name": { "type": "string" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
                    },
                    "422": { "description": "Invalid Google token" }
                }
            }
        },
        "/api/v1/auth/social/facebook": {
            "post": {
                "tags": ["Auth"],
                "summary": "Login or register via Facebook access token",
                "operationId": "9e0fd167bad1d9f16c2c0d6f7a15e21b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["access_token", "device_name"],
                                "properties": {
                                    "access_token": { "type": "string" },
                                    "device_name": { "type": "string" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
                    },
                    "422": { "description": "Invalid Facebook token" }
                }
            }
        },
        "/api/v1/me": {
            "get": {
                "tags": ["Profile"],
                "summary": "Get the authenticated user's profile",
                "operationId": "df361bae9ea631d3912cb371ff33ecb3",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": { "properties": { "data": { "$ref": "#/components/schemas/AppUser" } }, "type": "object" }
                            }
                        }
                    }
                },
                "security": [{ "sanctum": [] }]
            },
            "patch": {
                "tags": ["Profile"],
                "summary": "Update profile fields (POST also accepted)",
                "operationId": "e4650f49869ff84cd1e70055573fd8a9",
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "name": { "type": "string", "maxLength": 100 },
                                    "username": { "type": "string", "nullable": true, "maxLength": 50 },
                                    "avatar": { "type": "string", "format": "binary" },
                                    "bio": { "type": "string", "nullable": true },
                                    "gender": { "type": "string", "nullable": true, "enum": ["male", "female", "other", "prefer_not_to_say"] },
                                    "birth_date": { "type": "string", "format": "date", "nullable": true },
                                    "native_language_code": { "type": "string" },
                                    "learning_language_code": { "type": "string" },
                                    "proficiency_level": { "type": "string", "enum": ["beginner", "elementary", "intermediate", "upper_intermediate", "advanced", "native_like"] },
                                    "learning_goal": { "type": "string", "enum": ["travel", "school", "business", "anime", "conversation", "exam", "hobby", "other"] },
                                    "daily_goal_minutes": { "type": "integer" },
                                    "timezone": { "type": "string", "nullable": true },
                                    "reminder_time": { "type": "string", "example": "09:00", "nullable": true },
                                    "notifications_enabled": { "type": "boolean" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Updated",
                        "content": {
                            "application/json": {
                                "schema": { "properties": { "data": { "$ref": "#/components/schemas/AppUser" } }, "type": "object" }
                            }
                        }
                    }
                },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/me/coins": {
            "get": {
                "tags": ["Coins"],
                "summary": "Get current coin balance",
                "operationId": "765e507e033a489f36108b0a9ed6b820",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": { "properties": { "coins": { "type": "integer" } }, "type": "object" }
                            }
                        }
                    }
                },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/me/coins/transactions": {
            "get": {
                "tags": ["Coins"],
                "summary": "Paginated coin transaction ledger",
                "operationId": "e64be1fb82fa08ea1a032dedc2e6454a",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/CoinTransaction" } } },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/me/reads": {
            "get": {
                "tags": ["Reads"],
                "summary": "List vocab words the authenticated user has marked read (paginated)",
                "operationId": "3284b73fc88743b59aec2cd2cc315080",
                "responses": { "200": { "description": "OK" } },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/me/avatar": {
            "patch": {
                "tags": ["Avatars"],
                "summary": "Set one of the user's owned avatars as their active avatar",
                "operationId": "me_avatar_set_active",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["avatar_id"],
                                "properties": { "avatar_id": { "type": "integer", "example": 3 } },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Active avatar updated" },
                    "403": { "description": "Avatar not owned by user" },
                    "404": { "description": "Avatar not found" }
                },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/avatars": {
            "get": {
                "tags": ["Avatars"],
                "summary": "List all avatars with ownership status for the authenticated user",
                "operationId": "avatars_index",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": { "type": "array", "items": { "$ref": "#/components/schemas/Avatar" } }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/avatars/{avatar}/purchase": {
            "post": {
                "tags": ["Avatars"],
                "summary": "Purchase an avatar with coins",
                "operationId": "avatars_purchase",
                "parameters": [
                    { "name": "avatar", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": { "description": "Avatar purchased" },
                    "402": { "description": "Insufficient coins" },
                    "409": { "description": "Already owned" }
                },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/categories": {
            "get": {
                "tags": ["Public"],
                "summary": "List all vocab categories",
                "description": "When a valid Sanctum token is provided, `is_locked` reflects whether the authenticated user has unlocked that category.",
                "operationId": "e225c2b7eb5daf7fb16e00f4f07ff030",
                "responses": {
                    "200": {
                        "description": "List of vocab categories ordered by sort_order then name_en",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/VocabCategory" } } },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/categories/{category}/unlock": {
            "post": {
                "tags": ["Unlocks"],
                "summary": "Unlock a premium category with coins",
                "description": "Deducts `coin_price` coins from the user and records an unlock for the category and all its current words.",
                "operationId": "categories_unlock",
                "parameters": [
                    { "name": "category", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": {
                        "description": "Unlocked",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": { "message": { "type": "string" }, "coins_remaining": { "type": "integer" } },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": { "description": "Category is not premium or already unlocked" },
                    "402": { "description": "Insufficient coins" }
                },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/subcategories": {
            "get": {
                "tags": ["Public"],
                "summary": "List subcategories, optionally filtered by category",
                "description": "When a valid Sanctum token is provided, `is_locked` reflects whether the authenticated user has unlocked that subcategory.",
                "operationId": "3d35744905e4257c1e844a788b5fb31c",
                "parameters": [
                    {
                        "name": "category_id",
                        "in": "query",
                        "description": "Filter by parent category ID",
                        "required": false,
                        "schema": { "type": "integer", "example": 1 }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of subcategories ordered by sort_order then name_en",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/VocabSubcategory" } } },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/subcategories/{subcategory}/unlock": {
            "post": {
                "tags": ["Unlocks"],
                "summary": "Unlock a premium subcategory with coins",
                "description": "Deducts `coin_price` coins from the user and records an unlock for the subcategory and all its current words.",
                "operationId": "subcategories_unlock",
                "parameters": [
                    { "name": "subcategory", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": {
                        "description": "Unlocked",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": { "message": { "type": "string" }, "coins_remaining": { "type": "integer" } },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": { "description": "Subcategory is not premium or already unlocked" },
                    "402": { "description": "Insufficient coins" }
                },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/vocabularies": {
            "get": {
                "tags": ["Public"],
                "summary": "List approved vocab words with optional search and filters",
                "description": "When a valid Sanctum token is provided, locked words have their audio, sentences, and images nulled out and `is_locked` is true.",
                "operationId": "fee18a2abb523870482563179db17f1b",
                "parameters": [
                    { "name": "search", "in": "query", "description": "Search across word_jp, word_romaji, and word_en", "required": false, "schema": { "type": "string", "example": "neko" } },
                    { "name": "category_id", "in": "query", "description": "Filter words that belong to subcategories of this category", "required": false, "schema": { "type": "integer", "example": 1 } },
                    { "name": "subcategory_id", "in": "query", "description": "Filter words that belong to this subcategory", "required": false, "schema": { "type": "integer", "example": 3 } }
                ],
                "responses": {
                    "200": {
                        "description": "List of approved vocab words ordered by sort_order then word_jp",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/VocabWord" } } },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/words/{vocabulary}/read": {
            "post": {
                "tags": ["Reads"],
                "summary": "Mark a vocab word as read (first read awards coins)",
                "operationId": "e7a5b4118da9c49c8d6c2ffed05443cc",
                "parameters": [
                    { "name": "vocabulary", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "201": {
                        "description": "Marked read",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": { "read": { "type": "object" }, "coins": { "type": "integer" } },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/words/{vocabulary}/unlock": {
            "post": {
                "tags": ["Unlocks"],
                "summary": "Unlock a premium word with coins",
                "description": "Deducts `coin_price` coins from the user and records an unlock for the individual word. If the word's category or subcategory is already unlocked, returns 400.",
                "operationId": "words_unlock",
                "parameters": [
                    { "name": "vocabulary", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": {
                        "description": "Unlocked",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": { "message": { "type": "string" }, "coins_remaining": { "type": "integer" } },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": { "description": "Word is not premium or already unlocked" },
                    "402": { "description": "Insufficient coins" }
                },
                "security": [{ "sanctum": [] }]
            }
        },
        "/api/v1/favorites": {
            "get": {
                "tags": ["Favorites"],
                "summary": "List the authenticated user's favorite vocab words (paginated)",
                "operationId": "8d2bd7cabe6dbeca723fdd10fb66150d",
