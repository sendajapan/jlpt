                    "username": { "type": "string", "example": "smensulaiman", "nullable": true },
                    "email": { "type": "string", "format": "email" },
                    "email_verified": { "type": "boolean" },
                    "avatar": { "type": "string", "nullable": true },
                    "login_provider": { "type": "string", "enum": ["email", "google", "apple", "facebook", "guest"] },
                    "created_at": { "type": "string", "format": "date-time" },
                    "bio": { "type": "string", "nullable": true },
                    "gender": { "type": "string", "nullable": true, "enum": ["male", "female", "other", "prefer_not_to_say"] },
                    "birth_date": { "type": "string", "format": "date", "nullable": true },
                    "native_language_code": { "type": "string" },
                    "learning_language_code": { "type": "string" },
                    "proficiency_level": { "type": "string", "enum": ["beginner", "elementary", "intermediate", "upper_intermediate", "advanced", "native_like"] },
                    "learning_goal": { "type": "string", "enum": ["travel", "school", "business", "anime", "conversation", "exam", "hobby", "other"] },
                    "daily_goal_minutes": { "type": "integer" },
                    "timezone": { "type": "string", "nullable": true },
                    "reminder_time": { "type": "string", "nullable": true },
                    "notifications_enabled": { "type": "boolean" },
                    "coins": { "type": "integer" },
                    "xp_points": { "type": "integer" },
                    "current_level": { "type": "integer" },
                    "current_streak": { "type": "integer" },
                    "longest_streak": { "type": "integer" },
                    "learned_words": { "type": "integer" },
                    "completed_lessons": { "type": "integer" },
                    "total_study_minutes": { "type": "integer" },
                    "last_streak_at": { "type": "string", "format": "date-time", "nullable": true },
                    "last_seen_at": { "type": "string", "format": "date-time", "nullable": true },
                    "last_lesson_at": { "type": "string", "format": "date-time", "nullable": true },
                    "favorites_count": { "type": "integer" },
                    "reads_count": { "type": "integer" }
                },
                "type": "object"
            },
            "AuthResponse": {
                "properties": {
                    "user": { "$ref": "#/components/schemas/AppUser" },
                    "token": { "type": "string" }
                },
                "type": "object"
            },
            "ValidationError": {
                "properties": {
                    "message": { "type": "string" },
                    "errors": { "type": "object" }
                },
                "type": "object"
            },
            "CoinTransaction": {
                "properties": {
                    "id": { "type": "integer" },
                    "amount": { "type": "integer" },
                    "reason": { "type": "string" },
                    "reference_type": { "type": "string", "nullable": true },
                    "reference_id": { "type": "integer", "nullable": true },
                    "created_at": { "type": "string", "format": "date-time" }
                },
                "type": "object"
            },
            "Avatar": {
                "properties": {
                    "id": { "type": "integer", "example": 3 },
                    "name": { "type": "string", "example": "Sakura" },
                    "image_url": { "type": "string", "format": "uri" },
                    "coin_price": { "type": "integer", "example": 200 },
                    "is_owned": { "type": "boolean", "example": false }
                },
                "type": "object"
            },
            "VocabCategory": {
                "properties": {
                    "id": { "type": "integer", "example": 1 },
                    "name_en": { "type": "string", "example": "Animals", "nullable": true },
                    "name_jp": { "type": "string", "example": "どうぶつ", "nullable": true },
                    "name_romaji": { "type": "string", "example": "doubutsu", "nullable": true },
                    "icon_url": { "type": "string", "format": "uri", "nullable": true },
                    "icon_thumbnail_url": { "type": "string", "format": "uri", "nullable": true },
                    "category_bg_path": { "type": "integer", "example": 1, "nullable": true },
                    "bg_url": { "type": "string", "format": "uri", "nullable": true },
                    "audio_url": { "type": "string", "format": "uri", "nullable": true },
                    "sort_order": { "type": "integer", "example": 10, "nullable": true },
                    "is_premium": { "type": "boolean", "example": false },
                    "coin_price": { "type": "integer", "example": 100, "description": "Coins required to unlock this category (0 if not premium)" },
                    "is_locked": { "type": "boolean", "example": false, "description": "True when the authenticated user has not unlocked this premium category. Always false for unauthenticated requests." }
                },
                "type": "object"
            },
            "VocabSubcategory": {
                "properties": {
                    "id": { "type": "integer", "example": 3 },
                    "vocab_category_id": { "type": "integer", "example": 1 },
                    "name_en": { "type": "string", "example": "Farm Animals", "nullable": true },
                    "name_jp": { "type": "string", "example": "のうじょうのどうぶつ", "nullable": true },
                    "name_romaji": { "type": "string", "example": "noujou no doubutsu", "nullable": true },
                    "icon_url": { "type": "string", "format": "uri", "nullable": true },
                    "icon_thumbnail_url": { "type": "string", "format": "uri", "nullable": true },
                    "icon_thumbnail_bg": { "type": "integer", "example": 3, "nullable": true },
                    "bg_url": { "type": "string", "format": "uri", "nullable": true },
                    "audio_url": { "type": "string", "format": "uri", "nullable": true },
                    "sort_order": { "type": "integer", "example": 10, "nullable": true },
                    "is_premium": { "type": "boolean", "example": false },
                    "coin_price": { "type": "integer", "example": 100, "description": "Coins required to unlock this subcategory (0 if not premium)" },
                    "is_locked": { "type": "boolean", "example": false, "description": "True when the authenticated user has not unlocked this premium subcategory. Always false for unauthenticated requests." }
                },
                "type": "object"
            },
            "VocabWord": {
                "properties": {
                    "id": { "type": "integer", "example": 42 },
                    "vocab_subcategory_id": { "type": "integer", "example": 3 },
                    "word_jp": { "type": "string", "example": "ねこ" },
                    "word_romaji": { "type": "string", "example": "neko", "nullable": true },
                    "word_en": { "type": "string", "example": "cat", "nullable": true },
                    "sentence_jp": { "type": "string", "example": "ねこがいます。", "nullable": true, "description": "Null when the word is locked" },
                    "sentence_romaji": { "type": "string", "example": "Neko ga imasu.", "nullable": true, "description": "Null when the word is locked" },
                    "sentence_en": { "type": "string", "example": "There is a cat.", "nullable": true, "description": "Null when the word is locked" },
                    "audio_jp_url": { "type": "string", "format": "uri", "nullable": true, "description": "Null when the word is locked" },
                    "audio_en_url": { "type": "string", "format": "uri", "nullable": true, "description": "Null when the word is locked" },
                    "sentence_audio_jp_url": { "type": "string", "format": "uri", "nullable": true, "description": "Null when the word is locked" },
                    "sentence_audio_en_url": { "type": "string", "format": "uri", "nullable": true, "description": "Null when the word is locked" },
                    "image_url": { "type": "string", "format": "uri", "nullable": true, "description": "Null when the word is locked" },
                    "image_thumbnail_url": { "type": "string", "format": "uri", "nullable": true, "description": "Null when the word is locked" },
                    "image_thumbnail_bg": { "type": "integer", "example": 5, "nullable": true },
                    "bg_url": { "type": "string", "format": "uri", "nullable": true },
                    "sort_order": { "type": "integer", "example": 10, "nullable": true },
                    "is_premium": { "type": "boolean", "example": false },
                    "coin_price": { "type": "integer", "example": 100, "description": "Coins required to unlock this word (0 if not premium)" },
                    "is_locked": { "type": "boolean", "example": false, "description": "True when the authenticated user has not unlocked this premium word. Always false for unauthenticated requests." }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "bearerFormat": "Sanctum token",
                "scheme": "bearer"
            }
        }
